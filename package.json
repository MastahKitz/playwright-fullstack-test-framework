{
  "name": "qademo-test-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright test automation for QA Demo (https://qademo.com/)",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:firefox": "cross-env QA_BROWSER=firefox playwright test",
    "test:webkit": "cross-env QA_BROWSER=webkit playwright test",
    "test:edge": "cross-env QA_BROWSER=edge playwright test",
    "report": "playwright show-report test-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "typescript": "^5.6.0"
  }
}
