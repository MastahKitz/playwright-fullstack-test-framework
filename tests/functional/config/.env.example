# Copy this file to .env and fill in real values. .env is gitignored — each
# person keeps their own local copy. In CI these are supplied via GitHub
# Actions secrets instead (see .github/workflows/playwright.yml).

# Standard User - regular user account for testing
QA_STANDARD_USER_USERNAME=
QA_STANDARD_USER_PASSWORD=

# Locked User - account that is locked for negative testing
QA_LOCKED_USER_USERNAME=
QA_LOCKED_USER_PASSWORD=

# Admin User - admin account for admin feature testing. Password rotates daily
# to <prefix><DDMMYYYY>; only the prefix goes here, the date is computed in
# auth.data.ts.
QA_ADMIN_USER_USERNAME=
QA_ADMIN_USER_PASSWORD_PREFIX=

# Optional — which environment to run against (see environments.ts). Defaults to "demo".
# Options: local, staging, demo
QA_ENV=
